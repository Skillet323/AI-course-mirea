# Core
DATABASE_URL=sqlite:///./meeting_secretary.db
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=2048

# ASR
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
AUDIO_TARGET_SR=16000
AUDIO_NORMALIZE=true
AUDIO_REDUCE_NOISE=false

# Diarization
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=resemblyzer
HF_TOKEN=

# Task extraction
TASK_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TASK_MODEL=inclusionai/ring-2.6-1t:free
MIN_TRANSCRIPT_CONFIDENCE=0.6

# NVIDIA Build API fallback (get key at https://build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=
# Best by AMI benchmark (F1=0.203, 13/13 reliable): google/gemma-3n-e4b-it
# Runner-up (faster): qwen/qwen3-coder-480b-a35b-instruct
NVIDIA_TASK_MODEL=google/gemma-3n-e4b-it

# Optional legacy / alternates
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# CORS / frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST_PATH=frontend/dist